# Server
NODE_ENV=development
PORT=8081
CLIENT_URL=http://localhost:5174

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creatorsworld
DB_USER=postgres
DB_PASSWORD=your_password
DB_SYNC=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_make_it_long

# Paystack
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@creatorsworld.ng

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Homie ----
API_PORT=8082
# Business rules (defaults shown)
HOMIE_COMMISSION_RATE=0.10
HOMIE_AUTO_RELEASE_HOURS=48
HOMIE_CHEF_RESPONSE_HOURS=24
HOMIE_UNPAID_EXPIRY_MINUTES=120
HOMIE_MIN_LEAD_HOURS=12
HOMIE_CHECKIN_WINDOW_HOURS=3
# Background jobs (auto-release escrow, expiry, payout retries). Set to "off" to disable.
HOMIE_JOBS=on

# OTP delivery. "console" logs the code (and returns it as devCode in development).
SMS_PROVIDER=console
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=Homie

# Where Paystack sends the hirer after paying (the app watches for this URL in its WebView)
PAYSTACK_CALLBACK_URL=https://homie.app/payment-complete
# Point Paystack's webhook at: https://<your-host>/api/app/payments/webhook

RESEND_API_KEY=
